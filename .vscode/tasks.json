{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Sync Custom Endpoints",
			"command": "python",
			"args": [
				"-m",
				"clm_sync.cli",
				"--config",
				"${env:APPDATA}/Code/User/chatLanguageModels.json",
				"--all"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Sync Custom Endpoints in WT",
			"command": "wt",
			"args": [
				"-w",
				"0",
				"cmd",
				"/c",
				"python -m clm_sync.cli --config \"%APPDATA%\\Code\\User\\chatLanguageModels.json\" --all & echo. & pause"
			],
			"presentation": {
				"reveal": "silent",
				"close": true
			},
            "problemMatcher": []
		}
	]
}
